{
  "version": 2,
  "rewrites": [
    {
      "source": "/upload",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/__/auth/(.*)",
      "destination": "https://erp-notes-solutions.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
